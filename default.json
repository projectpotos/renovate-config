{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate preset for all projectpotos repositories.",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":enablePreCommit",
    "schedule:nonOfficeHours",
    "mergeConfidence:all-badges"
  ],
  "timezone": "Europe/Zurich",
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "No cooldown for our own releases",
      "matchPackageNames": ["projectpotos/**", "ghcr.io/projectpotos/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Dont update requires-python automatically to support multiple python versions",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "semanticCommitType": "fix",
    "commitMessageSuffix": ""
  },
  "reviewersFromCodeOwners": true
}
